# Konfigurasi LLM Universal (OpenAI-Compatible Standard)
# Contoh jalur produksi melalui proksi lokal (tanpa menyimpan API key di .env):
# LLM_BASE_URL=http://127.0.0.1:4000/v1beta/openai
# LLM_MODEL=gemma-4-26b-a4b-it
# LLM_API_KEY=
# VISION_MODEL=gemma-4-26b-a4b-it

LLM_BASE_URL=http://127.0.0.1:4000/v1beta/openai
LLM_MODEL=gemma-4-26b-a4b-it
LLM_API_KEY=

# Model Khusus Vision (Opsional - jika kosong akan memakai LLM_MODEL)
VISION_MODEL=gemma-4-26b-a4b-it

# Pengaturan Server & Keamanan Dashboard Web
HOST=127.0.0.1
PORT=3000

# Daftar origin tambahan yang diizinkan oleh CORS (pisahkan dengan koma, opsional)
CORS_ALLOWED_ORIGINS=

# Kunci perubahan baseUrl/model LLM dari dashboard (true/false)
LOCK_LLM_CONFIG=false

# Token autentikasi API opsional (jika diisi, request non-lokal / via Cloudflare Tunnel wajib membawa header Bearer/X-Dashboard-Token)
DASHBOARD_API_TOKEN=

# Izinkan request loopback murni (tanpa header proksi/Cloudflare) tanpa token (default: true)
ALLOW_LOCAL_NO_AUTH=true

# Batas maksimal ukuran unggahan berkas dalam byte (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Pengaturan Lokasi Default untuk Tools (Cuaca & Waktu)
DEFAULT_CITY=Tasikmalaya
DEFAULT_TIMEZONE=Asia/Jakarta

# Mode Operasi Bot (catatan: data/settings.json menimpa nilai ini saat startup jika sudah ada)
WHITELIST_ONLY=false
REPLY_GROUPS=false

# Delay Mengetik Alami & Jendela Anti-Spam Burst (Milidetik)
TYPING_DELAY_MIN=2000
TYPING_DELAY_MAX=4500
BURST_WINDOW_MS=4000

# Batas Riwayat Pesan per Kontak
MAX_HISTORY_MESSAGES=10

# Opsi Koneksi WhatsApp Tambahan (Opsional)
# Nomor dengan kode negara untuk meminta kode pairing 8 digit saat belum tertaut (misal 62812...)
PAIRING_PHONE=

# Proksi HTTPS untuk soket WhatsApp jika dibutuhkan
HTTPS_PROXY=

# Level log internal Baileys (default: error)
BAILEYS_LOG_LEVEL=error

# Tampilkan log JSON mentah Pino Baileys tanpa penyaringan (default: false agar terminal/bot.log rapi)
BAILEYS_RAW_LOGS=false

# Pengaturan Perintah Utilitas Media & Anti-Spam WhatsApp (Opsional)
# Batas maksimal ukuran media gambar/video masuk dalam byte (default 5 Megabyte)
MAX_MEDIA_BYTES=5242880

# Batas maksimal ukuran lampiran media untuk !ask khusus pemilik dalam byte (default 15 Megabyte)
MAX_ASK_MEDIA_BYTES=15728640

# Path biner FFmpeg (opsional, bawaan memakai 'ffmpeg' dari sistem) & durasi maksimal stiker bergerak (detik)
FFMPEG_PATH=ffmpeg
MAX_VIDEO_STICKER_SECONDS=8

# Kekuatan Gaussian blur untuk !text (piksel, default 2.0) dan intensitas burik shitpost untuk !cap (rentang 0.8-10.0, default 2.8)
TEXT_BLUR_SIGMA=2.0
CAP_BLUR_SIGMA=2.8

# Mode urutan efek burik (downscale -> kompresi JPEG/WebP kasar -> upscale) untuk !cap pada foto & stiker:
#   after  = tempel teks dulu, lalu burikkan foto/stiker dan teks bersamaan (gaya PENGALAMAN PAHIT / IJIN TAMPIL, default)
#   before = burikkan foto/stiker dulu, lalu tempel teks + kompresi penyatu ringan (gaya KESALAHAN POLA PIKIR / BERSIAPLAH)
CAP_BLUR_MODE=after

# Intensitas kompresi penyatu khusus teks !cap saat CAP_BLUR_MODE=before (terpisah dari CAP_BLUR_SIGMA):
#   0 = teks tajam penuh, 0.3-4.0 = teks ikut sedikit burik/pecah menyatu (default: 1.0)
CAP_TEXT_BLUR_SIGMA=1.0

# Resolusi sisi terpanjang kanvas keluaran foto !cap (piksel, rentang 240-1080, default: 640)
# Mempertahankan 640 piksel membuat artefak burik hasil downscale->upscale tetap terlihat tegas di WhatsApp
CAP_MAX_DIM=640

# Skala ukuran font Impact pada !cap untuk foto & stiker (rentang 0.5-1.6, default: 1.0)
# Perkecil di bawah 1.0 (misal 0.85) bila ingin font lebih kecil lagi, atau naikkan (misal 1.2) bila ingin lebih besar
CAP_FONT_SCALE=1.0

# Metadata bawaan paket stiker WhatsApp (!sticker / !stext / !wm)
STICKER_PACK_NAME=Another Me
STICKER_PACK_AUTHOR=Kiraya

# Ambang batas pelindung anti-spam perintah utilitas (opsional)
CMD_KNOWN_COOLDOWN_MS=3000
CMD_KNOWN_MAX_10MIN=20
CMD_UNKNOWN_TEXT_COOLDOWN_MS=6000
CMD_UNKNOWN_MEDIA_COOLDOWN_MS=10000
CMD_UNKNOWN_MAX_10MIN=5
CMD_UNKNOWN_MAX_HOUR=15
CMD_FLOOD_MUTE_MS=1800000
CMD_GLOBAL_MAX_MIN=15
CMD_UNKNOWN_GLOBAL_MAX_HOUR=40
CMD_MAX_NEW_UNKNOWN_HOUR=10

# Perintah utilitas di grup untuk anggota lain (AI auto-reply grup tetap mengikuti REPLY_GROUPS)
ALLOW_GROUP_COMMANDS=true
CMD_GROUP_COOLDOWN_MS=5000
CMD_GROUP_MAX_10MIN=15
