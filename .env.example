# Konfigurasi LLM Universal (OpenAI-Compatible Standard)
# Contoh jalur produksi melalui proksi lokal (tanpa menyimpan API key di .env):
# LLM_BASE_URL=http://127.0.0.1:4000/v1beta/openai
# LLM_MODEL=gemma-4-26b-a4b-it
# LLM_API_KEY=
# VISION_MODEL=gemma-4-26b-a4b-it

LLM_BASE_URL=http://127.0.0.1:4000/v1beta/openai
LLM_MODEL=gemma-4-26b-a4b-it
LLM_API_KEY=

# Model Khusus Vision (Opsional - jika kosong akan memakai LLM_MODEL)
VISION_MODEL=gemma-4-26b-a4b-it

# Pengaturan Server & Keamanan Dashboard Web
HOST=127.0.0.1
PORT=3000
# Daftar origin tambahan yang diizinkan oleh CORS (pisahkan dengan koma, opsional)
CORS_ALLOWED_ORIGINS=
# Kunci perubahan baseUrl/model LLM dari dashboard (true/false)
LOCK_LLM_CONFIG=false
# Token autentikasi API opsional (jika diisi, request non-loopback wajib membawa header Bearer/X-Dashboard-Token)
DASHBOARD_API_TOKEN=
# Batas maksimal ukuran unggahan berkas dalam byte (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Pengaturan Lokasi Default untuk Tools (Cuaca & Waktu)
DEFAULT_CITY=Tasikmalaya
DEFAULT_TIMEZONE=Asia/Jakarta

# Mode Operasi Bot (catatan: data/settings.json menimpa nilai ini saat startup jika sudah ada)
WHITELIST_ONLY=false
REPLY_GROUPS=false

# Delay Mengetik Alami & Jendela Anti-Spam Burst (Milidetik)
TYPING_DELAY_MIN=2000
TYPING_DELAY_MAX=4500
BURST_WINDOW_MS=4000

# Batas Riwayat Pesan per Kontak
MAX_HISTORY_MESSAGES=10

# Opsi Koneksi WhatsApp Tambahan (Opsional)
# Nomor dengan kode negara untuk meminta kode pairing 8 digit saat belum tertaut (misal 62812...)
PAIRING_PHONE=
# Proksi HTTPS untuk soket WhatsApp jika dibutuhkan
HTTPS_PROXY=
# Level log internal Baileys (default: error)
BAILEYS_LOG_LEVEL=error
