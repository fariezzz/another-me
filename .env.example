# Konfigurasi LLM Universal (OpenAI-Compatible Standard)
# Anda bisa menggunakan provider apa saja:
# - Ollama Cloud : https://ollama.com/v1
# - Ollama Local : http://localhost:11434/v1
# - Groq         : https://api.groq.com/openai/v1
# - OpenRouter   : https://openrouter.ai/api/v1
# - OpenAI       : https://api.openai.com/v1
# - DeepSeek     : https://api.deepseek.com/v1

LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gemma4
LLM_API_KEY=your_api_key_here

# Model Khusus Vision (Opsional - jika kosong akan memakai LLM_MODEL)
# Contoh: gemma4, llava, qwen2.5-vl, gpt-4o-mini
VISION_MODEL=

# Port Web Dashboard UI
PORT=3000

# Pengaturan Lokasi Default untuk Tools (Cuaca & Waktu)
DEFAULT_CITY=Tasikmalaya
DEFAULT_TIMEZONE=Asia/Jakarta

# Mode Operasi Bot
WHITELIST_ONLY=false
REPLY_GROUPS=false

# Delay Mengetik Alami (Milidetik)
TYPING_DELAY_MIN=2000
TYPING_DELAY_MAX=4500

# Batas Riwayat Pesan per Kontak
MAX_HISTORY_MESSAGES=10
